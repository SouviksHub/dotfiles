# Copy to .env and fill in. Never commit .env.

# Tapo app > camera > Settings > Advanced Settings > Camera Account.
# Same username/password on both cameras keeps this simple.
FRIGATE_RTSP_USER=
FRIGATE_RTSP_PASSWORD=
# Reserve these IPs as DHCP reservations on your router so they never change.
FRIGATE_FRONT_IP=192.168.1.50
FRIGATE_OUTSIDE_IP=192.168.1.51

# Claude API (console.anthropic.com)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
# low | medium | high  (per-event review effort; medium is the cost/quality sweet spot here)
CLAUDE_EFFORT=medium
FRAMES_PER_EVENT=10

# Telegram: message @BotFather -> /newbot for the token; message your bot once,
# then open https://api.telegram.org/bot<TOKEN>/getUpdates to read your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Dashboard login (HTTP basic auth, on top of Tailscale)
DASHBOARD_USER=owner
DASHBOARD_PASSWORD=

MEDIA_DIR=./media
EVIDENCE_DIR=./evidence

# External dead-man switch: create a free check at healthchecks.io (period 5 min,
# grace 5 min), connect its Telegram integration, paste the ping URL here.
# If the box loses power, is unplugged or stolen, healthchecks.io alerts you.
HEALTHCHECK_URL=

# Off-site evidence copies (Backblaze B2). Create a bucket with versioning on, and an
# application key limited to that bucket WITHOUT deleteFiles capability.
OFFSITE_BUCKET=
RCLONE_CONFIG_OFFSITE_TYPE=b2
RCLONE_CONFIG_OFFSITE_ACCOUNT=
RCLONE_CONFIG_OFFSITE_KEY=
RCLONE_CONFIG_OFFSITE_HARD_DELETE=false

# ---- POS ----
SHOP_NAME=SARKER MEDICAL HALL
POS_TIMEZONE=Asia/Dhaka
# Long random string: python3 -c "import secrets; print(secrets.token_hex(32))"
POS_SECRET=
# First owner account, created on first start only. Owner PIN: 6-8 digits.
POS_OWNER_NAME=
POS_OWNER_PIN=
# LAN thermal printer (ESC/POS on port 9100); the cash drawer plugs into it.
PRINTER_HOST=192.168.1.60
